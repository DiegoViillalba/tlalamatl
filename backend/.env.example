# Copia este archivo a backend/.env (git lo ignora).

# Firma de los tokens del login demo. Tiene un valor de desarrollo por defecto.
TLALAMATL_SECRET=

# Login por correo con Supabase. Si se deja vacío, solo funciona el login demo.
# Supabase → Project Settings → API Keys → Project URL (https://<ref>.supabase.co)
SUPABASE_URL=

# Solo si el proyecto todavía firma con el "JWT secret" legacy (Project Settings → JWT Keys).
# Con las llaves asimétricas (lo normal en proyectos nuevos) se deja vacío: basta con SUPABASE_URL.
SUPABASE_JWT_SECRET=
