# Copia este archivo a .env.local (git lo ignora).

# URL del backend (por defecto http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Login por correo con Supabase. Si se dejan vacías, solo funciona el login demo.
# Supabase → Project Settings → API Keys. La publishable key es pública; NUNCA pongas aquí la secret/service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
